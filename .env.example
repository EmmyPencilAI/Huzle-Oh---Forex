# HUZLE OH — AGENTIC TRADER
# Production Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO THIS FILE

# ------------------------------------------------------------------------------
# RENDER HOSTING & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# PORT is dynamically provided by Render in production.
PORT=3000
NODE_ENV=production

# Host URL for callbacks and public access (e.g., https://huzle-oh-web.onrender.com)
APP_URL="https://huzle-oh-web.onrender.com"

# Target Web Service URL used by the background watchdog worker to ping /health
WEB_SERVICE_URL="http://localhost:3000"
HEALTH_CHECK_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# EXNESS & METATRADER 5 CREDENTIALS (Stored securely at rest, never logged)
# ------------------------------------------------------------------------------
EXNESS_MT5_LOGIN=""
EXNESS_MT5_PASSWORD=""
EXNESS_MT5_SERVER="Exness-MT5Real"

# ------------------------------------------------------------------------------
# TELEGRAM BOT ALERTS & REAL-TIME PROPOSALS
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# ARTIFICIAL INTELLIGENCE & LLM REASONING ENGINES
# ------------------------------------------------------------------------------
# Gemini API Key for Head of Desk multi-agent reasoning synthesis
GEMINI_API_KEY=""

# Optional secondary LLM providers (xAI Grok / Local Ollama)
GROK_API_KEY=""
GROK_API_URL="https://api.x.ai/v1"
GROK_MODEL="grok-beta"

LOCAL_LLM_API_URL="http://localhost:11434/v1"
LOCAL_LLM_API_KEY=""
LOCAL_LLM_MODEL="llama3"

# ------------------------------------------------------------------------------
# SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# 32-byte hexadecimal string for AES-256-GCM credential encryption at rest
ENCRYPTION_KEY=""
JWT_SECRET=""
